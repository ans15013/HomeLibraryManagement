{% extends "base.html.jinja" %}
{% block title %}Lista wydawc&oacute;w{% endblock %}
{% block content %}
    <section class="w-full grid gap-4 mt-4">
        <div class="flex flex-col bg-white rounded-lg shadow-md p-4">
            <h3 class="text-md font-semibold mb-2">Wydawcy</h3>
            {% for publisher in publishers %}
                <div class="border-b py-2">
                    <div class="flex items-center justify-between gap-3">
                        <a href="{% url 'publisher' publisher.id %}" class="text-blue-500 hover:underline">{{ publisher.name }}</a>
                        <a href="{% url 'edit_publisher' publisher.id %}" class="text-sm text-emerald-700 hover:underline">Edytuj</a>
                    </div>
                    <p class="text-sm text-gray-600">
                        {{ publisher.get_country_display }}
                        {% if publisher.founded_year %}
                            &bull; za&lstrok;. {{ publisher.founded_year }}
                        {% endif %}
                    </p>
                    {% if publisher.website %}
                        <a href="{{ publisher.website }}" class="text-sm text-blue-500 hover:underline" target="_blank" rel="noopener">
                            {{ publisher.website }}
                        </a>
                    {% endif %}
                </div>
            {% empty %}
                <p class="text-gray-600">Brak wydawc&oacute;w do wy&sacute;wietlenia.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
