{% extends "base.html.jinja" %}
{% block title %}Lista notatek{% endblock %}
{% block content %}
    <section class="w-full grid gap-4 mt-4">
        <div class="flex flex-col bg-white rounded-lg shadow-md p-4">
            <h3 class="text-md font-semibold mb-2">Notatki</h3>
            {% for note in notes %}
                <div class="border-b py-2">
                    <div class="flex items-center justify-between gap-3">
                        <a href="{% url 'note' note.id %}" class="text-blue-500 hover:underline">
                            {% if note.book %}{{ note.book.title }}{% else %}Notatka bez książki{% endif %}
                        </a>
                        <a href="{% url 'edit_note' note.id %}" class="text-sm text-emerald-700 hover:underline">Edytuj</a>
                    </div>
                    <p class="text-sm text-gray-600">{{ note.created_at|date:"Y-m-d H:i" }}</p>
                    <p class="mt-1">{{ note.content|truncatechars:200 }}</p>
                </div>
            {% empty %}
                <p class="text-gray-600">Brak notatek do wy&sacute;wietlenia.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
