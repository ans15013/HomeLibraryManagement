{% extends "base.html.jinja" %}
{% block title %}Lista serii{% endblock %}
{% block content %}
    <section class="w-full grid gap-4 mt-4">
        <div class="flex flex-col bg-white rounded-lg shadow-md p-4">
            <h3 class="text-md font-semibold mb-2">Serie</h3>
            {% for item in series %}
                <div class="border-b py-2">
                    <div class="flex items-center justify-between gap-3">
                        <a href="{% url 'series' item.id %}" class="text-blue-500 hover:underline">{{ item.name }}</a>
                        <a href="{% url 'edit_series' item.id %}" class="text-sm text-emerald-700 hover:underline">Edytuj</a>
                    </div>
                    {% if item.description %}
                        <p class="text-sm text-gray-600">{{ item.description }}</p>
                    {% endif %}
                </div>
            {% empty %}
                <p class="text-gray-600">Brak serii do wy&sacute;wietlenia.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
