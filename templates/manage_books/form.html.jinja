{% extends "base.html.jinja" %}
{% block title %}{{ title }}{% endblock %}
{% block content %}
    <section class="w-full grid gap-4 mt-4">
        <form method="post" class="flex flex-col gap-4 bg-white rounded-lg shadow-md p-4">
            {% csrf_token %}

            {% if form.non_field_errors %}
                <div class="rounded bg-red-50 p-3 text-red-700">
                    {{ form.non_field_errors }}
                </div>
            {% endif %}

            {% for field in form %}
                <div class="grid gap-1">
                    <label for="{{ field.id_for_label }}" class="font-semibold">{{ field.label }}</label>
                    {{ field }}
                    {% if field.help_text %}
                        <p class="text-sm text-gray-600">{{ field.help_text }}</p>
                    {% endif %}
                    {% for error in field.errors %}
                        <p class="text-sm text-red-600">{{ error }}</p>
                    {% endfor %}
                </div>
            {% endfor %}

            <div class="flex gap-3">
                <button type="submit" class="rounded bg-emerald-800 px-4 py-2 font-semibold text-white hover:bg-emerald-900">
                    {{ submit_label }}
                </button>
                <a href="{% url cancel_url %}" class="rounded bg-neutral-200 px-4 py-2 font-semibold text-neutral-900 hover:bg-neutral-300">
                    Anuluj
                </a>
            </div>
        </form>
    </section>
{% endblock %}
